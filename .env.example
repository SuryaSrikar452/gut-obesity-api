# Supabase (service key stays on the server only)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=replace-me
# Brevo (OTP emails)
BREVO_API_KEY=replace-me
# >= 32 random chars: python -c "import secrets;print(secrets.token_urlsafe(48))"
TOKEN_SECRET=replace-me-with-48-random-chars
# Public https URL of this API; used inside QR codes. Never localhost / LAN in production.
PUBLIC_BASE_URL=https://your-service.onrender.com
APP_ENV=production
# Only if the frontend is hosted on a different origin (comma separated)
ALLOWED_ORIGINS=
